DATABASE_HOST=''
DATABASE_PORT=''
DATABASE_NAME=''
DATABASE_USER=''
DATABASE_PASSWORD=''

DEBUG=''

# 許可するフロントエンドのオリジンをカンマ区切りで設定する（末尾スラッシュ不要）
# local: http://localhost:3000
ALLOWED_ORIGINS=''

ANTHROPIC_MODEL=''
SUMMARY_BATCH_HOUR=''
# 次の値は environments/.env.secret に書く（Git管理外）
#   APP_PASSWORD='000'                 現場スタッフ用パスワードの初期値（画面から変更後はDBの値を使用）
#   SUPPORT_PASSWORD='111'             サポートチーム用パスワードの初期値
#   STAFF_ADMIN_PASSWORD='...'         現場スタッフ管理者パスワードの初期値（未設定だと現場スタッフ管理者はログイン不可）
#   SUPPORT_ADMIN_PASSWORD='...'       サポートチーム管理者パスワードの初期値（旧名 ADMIN_PASSWORD でも可。未設定だとログイン不可）
#   ANTHROPIC_API_KEY='sk-ant-...'     Claude APIキー
#   NOTIFY_WEBHOOK_URL='https://...'   Slack/Teams などへの通知用 Incoming Webhook URL
