DATABASE_HOST='db'
DATABASE_PORT='3306'
DATABASE_NAME='database'
DATABASE_USER='user'
DATABASE_PASSWORD='password'

DEBUG='true'

ALLOWED_ORIGINS='http://localhost:3000'

# 使用するClaudeのモデル
ANTHROPIC_MODEL='claude-opus-5'
# 自動要約バッチを毎日実行する時刻（時）
SUMMARY_BATCH_HOUR='3'
# ANTHROPIC_API_KEY はこのファイルに書かない（Gitに公開されるため）。environments/.env.secret に書く
